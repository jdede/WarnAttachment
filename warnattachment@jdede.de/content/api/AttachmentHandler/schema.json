[
  {
    "namespace": "AttachmentHandler",
    "events" : [
        {
            "name" : "onOpenAttachment",
            "type" : "function",
            "description" : "Called if an attachment is opened",
            "parameters": [
                {
                    "name" : "attachmentInfo",
                    "type" : "object",
                    "description" : "The attachment info object"
                }
            ],
            "returns" : {
                "type" : "boolean",
                "description" : "True if allowed"
            }
        }
    ],
    "functions": [
        {
            "name": "getExtensionsForType",
            "type": "function",
            "async": true,
            "description": "Returns the file extensions the system associates with a MIME type",
            "parameters": [
                {
                    "name": "contentType",
                    "type": "string"
                }
            ]
        }
    ]
  }
]

